---
interface SpecRow { label: string; value?: string | number | null; note?: string }
const { rows, missing = "Not available" } = Astro.props;
---
<table class="data-table">
  <thead><tr><th>Specification</th><th>Value</th></tr></thead>
  <tbody>
    {rows.map((r: SpecRow) => (
      <tr>
        <td>{r.label}</td>
        <td>{r.value != null && r.value !== "" ? `${r.value}${r.note ? " · " + r.note : ""}` : missing}</td>
      </tr>
    ))}
  </tbody>
</table>
