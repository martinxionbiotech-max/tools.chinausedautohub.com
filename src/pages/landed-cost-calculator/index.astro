---
import BaseLayout from "../../../shared/components/BaseLayout.astro";
import { TOOLS_SITE_URL, MARKET_SITE_URL, DATA_SITE_URL, MAIN_SITE_URL } from "../../../shared/config/config";
import countriesData from "../../../shared/data/countries.json";
import taxrulesData from "../../../shared/data/taxrules.json";
import modelsData from "../../../shared/data/models.json";
import brandsData from "../../../shared/data/brands.json";
import "../../styles/tools.css";

const siteTitle = "China Used Car Export Tools";
const pageUrl = TOOLS_SITE_URL + "/landed-cost-calculator/";

const countries = countriesData.countries;
const taxrules = taxrulesData.taxrules;
const models = modelsData.models;
const brandName = Object.fromEntries(brandsData.brands.map((b) => [b.brand_id, b.name]));

// Pre-build lookup: country_id -> { import_duty: rule, vat: rule }
const taxByCountry = {};
for (const r of taxrules) {
  (taxByCountry[r.country_id] = taxByCountry[r.country_id] || {})[r.tax_type] = r;
}

const webApp = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Landed Cost Calculator",
  url: pageUrl,
  applicationCategory: "FinanceApplication",
  operatingSystem: "Web",
  description: "Estimate the total landed cost of a used vehicle — vehicle price, shipping, insurance, import duty, VAT, port charges and local fees — for 82 destination markets.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Tools", item: TOOLS_SITE_URL + "/" },
    { "@type": "ListItem", position: 2, name: "Landed Cost Calculator", item: pageUrl },
  ],
};
---

<BaseLayout
  siteTitle={siteTitle}
  siteUrl={TOOLS_SITE_URL}
  currentSection="tools"
  title="Landed Cost Calculator — China Used Car Export"
  description="Estimate the total landed cost of importing a used vehicle: vehicle price, shipping, insurance, import duty, VAT, port charges and local fees. Transparent formulas with source and date for every rate."
  canonical="/landed-cost-calculator/"
  lastUpdated="2026-10-07"
  jsonLd={[webApp, breadcrumb]}
  breadcrumbs={[
    { name: "Tools", url: TOOLS_SITE_URL + "/" },
    { name: "Landed Cost Calculator", url: pageUrl },
  ]}
>
  <h1>Landed Cost Calculator</h1>
  <p class="lede">
    Estimate what a vehicle really costs when it lands in the destination
    country — vehicle, shipping, insurance, duty, VAT, and local charges.
  </p>

  <div class="section">
    <h2>Inputs</h2>
    <div class="form-grid">
      <div class="field">
        <label for="model">Vehicle model (optional)</label>
        <select id="model">
          <option value="">— Select a vehicle —</option>
          {models.map((m) => <option value={m.model_id}>{brandName[m.brand_id]} {m.name} ({m.body_type})</option>)}
        </select>
        <span class="hint">Specs from data.chinausedautohub.com. Base price is not in the vehicle database — see current listings on the main site.</span>
      </div>
      <div class="field">
        <label for="vehicle">Vehicle price (USD)</label>
        <input id="vehicle" type="number" inputmode="decimal" min="0" step="any" placeholder="e.g. 20000" />
      </div>
      <div class="field">
        <label for="country">Destination country</label>
        <select id="country">
          {countries.map((c) => <option value={c.country_id}>{c.name}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="shipping">Shipping cost (USD)</label>
        <input id="shipping" type="number" inputmode="decimal" min="0" step="any" placeholder="e.g. 2500" />
        <span class="hint">You provide this — we do not publish unverified freight rates.</span>
      </div>
      <div class="field">
        <label for="insurance">Insurance (USD)</label>
        <input id="insurance" type="number" inputmode="decimal" min="0" step="any" placeholder="e.g. 200" />
      </div>
      <div class="field">
        <label for="port">Port charges (USD)</label>
        <input id="port" type="number" inputmode="decimal" min="0" step="any" placeholder="e.g. 400" />
        <span class="hint">Destination port handling. Estimated by you.</span>
      </div>
      <div class="field">
        <label for="local">Other local fees (USD)</label>
        <input id="local" type="number" inputmode="decimal" min="0" step="any" placeholder="e.g. 600" />
        <span class="hint">Clearance, registration, inspection, etc.</span>
      </div>
    </div>
    <p class="form-error" id="error"></p>
  </div>

  <div class="section">
    <h2>Applied rates</h2>
    <div id="rate-box" class="rate-card">
      <p class="rate-meta">Select a destination country to load duty and VAT rates.</p>
    </div>
    <p class="rate-meta" id="model-note"></p>
    <p class="rate-meta" id="fx-note"></p>
  </div>

  <div class="section">
    <h2>Estimated result</h2>
    <div class="result-panel" id="result">
      <p class="rate-meta">Enter a vehicle price to see the breakdown.</p>
    </div>
  </div>

  <div class="section">
    <h2>Estimate vs. official quote vs. customs assessment</h2>
    <ul>
      <li><strong>Estimate</strong> — the figure this tool calculates, for planning only.</li>
      <li><strong>Official quote</strong> — a binding figure confirmed with a supplier, freight forwarder or customs broker.</li>
      <li><strong>Actual customs assessment</strong> — the destination customs authority's final determination.</li>
    </ul>
  </div>

  <div class="section">
    <h2>Formula</h2>
    <p>Every line is an <strong>estimate</strong>. The formula is transparent:</p>
    <div class="formula">CIF value   = Vehicle price + Shipping + Insurance
Import duty = CIF value × Import duty %
VAT         = (CIF value + Import duty) × VAT %
Landed cost = Vehicle + Shipping + Insurance + Duty + VAT + Port charges + Other local fees</div>
    <p>Duty basis "CIF value" and VAT basis "CIF + duty" follow the stored tax-rule <code>basis</code> fields.</p>
  </div>

  <div class="section">
    <h2>Limitations</h2>
    <ul>
      <li>Exchange rates are a snapshot — they fluctuate daily.</li>
      <li>Tax rates come from <strong>market.chinausedautohub.com</strong> taxrules.json and are flagged <strong>needs review</strong>; confirm with the destination customs authority.</li>
      <li>Excludes destination-port incidental fees not entered, inland transport, and any age/engine-specific duty bands not modeled.</li>
      <li>Shipping is user-entered; we never publish unverified freight quotes.</li>
    </ul>
  </div>

  <div class="section">
    <h2>Assumptions</h2>
    <ul>
      <li>Duty is applied to CIF value; VAT is applied to CIF + duty (per each stored tax-rule <code>basis</code>).</li>
      <li>Shipping, insurance, port charges and local fees are the figures you enter — none are assumed.</li>
      <li>Flat baseline duty and VAT rates are used; age/engine-specific duty bands are not modeled.</li>
    </ul>
  </div>

  <div class="section">
    <h2>Data source</h2>
    <ul>
      <li>Import duty &amp; VAT rates: <strong>market.chinausedautohub.com</strong> taxrules.json, checked <strong>2026-10-07</strong> (many flagged needs review).</li>
      <li>Vehicle specifications: <strong>data.chinausedautohub.com</strong> models.json, checked <strong>2026-10-07</strong>.</li>
      <li>Exchange rates: <strong>tool.chinausedautohub.com</strong> fx.json snapshot, dated <strong>2026-10-04</strong>.</li>
      <li>Country data: market.chinausedautohub.com countries.json.</li>
    </ul>
  </div>

    <div class="section">
    <h2>Last updated</h2>
    <ul>
      <li>Wiring verified <strong>2026-10-07</strong>.</li>
    </ul>
  </div>

  <div class="note warn">
    <strong>Disclaimer:</strong> Estimate ≠ final quotation. Confirm current duty, VAT and FX with official authorities before transacting.
  </div>

  <div class="section">
    <h2>Example</h2>
    <p>BYD Song Plus (PHEV) shipped to Kenya, assuming Kenya duty 25% and VAT 16%:</p>
    <div class="formula">Vehicle $20,000 + Shipping $2,500 + Insurance $200 → CIF = $22,700
Duty 25% of $22,700 = $5,675
VAT 16% of ($22,700 + $5,675) = $4,540
+ Port $400 + Local fees $600
Estimated landed cost = $33,915</div>
    <p class="rate-meta">Rates are baselines from market.chinausedautohub.com taxrules.json (checked 2026-10-07, needs review). Actual duty depends on age, engine and customs valuation.</p>
  </div>

  <div class="section">
    <h2>Related vehicles</h2>
    <div class="related-grid">
      <a href={DATA_SITE_URL + "/models/byd-song-plus/"}>BYD Song Plus</a>
      <a href={DATA_SITE_URL + "/models/byd-atto-3/"}>BYD Atto 3</a>
      <a href={DATA_SITE_URL + "/models/geely-monjaro/"}>Geely Monjaro</a>
      <a href={DATA_SITE_URL + "/models/chery-tiggo-8/"}>Chery Tiggo 8</a>
    </div>
  </div>

  <div class="section">
    <h2>Related countries</h2>
    <div class="related-grid">
      {countries.map((c) => (
        <a href={MARKET_SITE_URL + "/countries/" + c.country_id + "/"}>{c.name}</a>
      ))}
    </div>
  </div>

    <div class="section">
    <h2>Next steps</h2>
    <div class="related-grid">
      <a href={DATA_SITE_URL + "/"}>Vehicle Data</a>
      <a href={MARKET_SITE_URL + "/"}>Market Data</a>
      <a href={MAIN_SITE_URL + "/cars/"}>Inventory</a>
      <a href={MAIN_SITE_URL + "/contact/"}>Request Quote</a>
    </div>
  </div>

<div class="cta-band">
    <h2>Request a vehicle</h2>
    <p>Ready to buy? Get a real quote on available vehicles.</p>
    <a class="btn" href={MAIN_SITE_URL + "/contact/"}>Request a Vehicle</a>
  </div>
</BaseLayout>

<script type="application/json" id="tax-by-country" set:html={JSON.stringify(taxByCountry)}></script>
<script type="application/json" id="models-data" set:html={JSON.stringify(models)}></script>
<script type="application/json" id="brand-name" set:html={JSON.stringify(brandName)}></script>
<script type="application/json" id="site-config" set:html={JSON.stringify({ marketUrl: MARKET_SITE_URL, dataUrl: DATA_SITE_URL, mainUrl: MAIN_SITE_URL })}></script>
<script>
  import { calcLandedCost, fmtMoney, fmtEstimate } from "../../lib/calc.js";

  const taxByCountry = JSON.parse(document.getElementById("tax-by-country").textContent);
  const models = JSON.parse(document.getElementById("models-data").textContent);
  const brandName = JSON.parse(document.getElementById("brand-name").textContent);
  const { marketUrl, dataUrl, mainUrl } = JSON.parse(document.getElementById("site-config").textContent);

  const el = (id) => document.getElementById(id);
  const ids = ["vehicle", "shipping", "insurance", "port", "local"];

  function renderModelNote() {
    const mid = el("model").value;
    const note = el("model-note");
    if (!mid) { note.textContent = ""; return; }
    const m = models.find((x) => x.model_id === mid);
    const label = m ? `${brandName[m.brand_id]} ${m.name}` : mid;
    note.innerHTML =
      `${label}: specifications on <a href="${dataUrl}/models/${mid}/" target="_blank" rel="noopener">Vehicle Data →</a> · ` +
      `current price on <a href="${mainUrl}/cars/" target="_blank" rel="noopener">Inventory →</a> (base price is not published in the vehicle database).`;
  }

  function num(id) {
    const v = el(id).value.trim();
    if (v === "") return 0;
    const n = Number(v);
    return Number.isFinite(n) && n >= 0 ? n : NaN;
  }

  function renderRates(countryId) {
    const box = el("rate-box");
    const c = taxByCountry[countryId];
    const duty = c && c.import_duty;
    const vat = c && c.vat;
    if (!duty && !vat) {
      box.innerHTML = '<p class="rate-meta">No tax rules loaded for this country.</p>';
      return;
    }
    const row = (label, rule) => {
      if (!rule) return "";
      const flag = rule.needs_review
        ? ' <span class="badge badge-review">needs review</span>'
        : "";
      return `<div class="rate-row">
        <span>${label}</span>
        <span class="rate-pct">${rule.rate_pct}%</span>
        <span class="rate-meta">${rule.label} · ${rule.basis}${flag}<br/>
        Source: ${rule.source} · ${rule.last_checked}</span>
      </div>`;
    };
    box.innerHTML =
      row("Import duty", duty) + row("VAT", vat) +
      `<p class="rate-meta" style="margin-top:8px">
        <a href="${marketUrl}/countries/${countryId}/" target="_blank" rel="noopener">Check current regulations →</a>
      </p>`;
  }

  function compute() {
    const countryId = el("country").value;
    renderRates(countryId);
    renderModelNote();

    const vals = {};
    let ok = true;
    for (const id of ids) {
      vals[id] = num(id);
      if (Number.isNaN(vals[id])) {
        ok = false;
        el(id).classList.add("invalid");
      } else {
        el(id).classList.remove("invalid");
      }
    }
    const err = el("error");
    if (!ok) {
      err.textContent = "All inputs must be non-negative numbers.";
      el("result").innerHTML = '<p class="rate-meta">Fix the highlighted fields to see the breakdown.</p>';
      return;
    }
    err.textContent = "";

    const c = taxByCountry[countryId] || {};
    const r = calcLandedCost({
      vehiclePrice: vals.vehicle,
      shipping: vals.shipping,
      insurance: vals.insurance,
      portCharges: vals.port,
      localFees: vals.local,
      dutyRatePct: (c.import_duty && c.import_duty.rate_pct) || 0,
      vatRatePct: (c.vat && c.vat.rate_pct) || 0,
    });

    const line = (label, v) =>
      `<div class="result-line"><span>${label}</span><span class="val">${fmtMoney(v)}</span></div>`;
    const eline = (label, v) =>
      `<div class="result-line"><span>${label}</span><span class="val">${fmtEstimate(v)}</span></div>`;
    el("result").innerHTML =
      line("Vehicle cost", r.vehicleCost) +
      line("Shipping", r.shipping) +
      line("Insurance", r.insurance) +
      eline("Import duty", r.importDuty) +
      eline("VAT", r.vat) +
      line("Port charges", r.portCharges) +
      line("Other local fees", r.localFees) +
      `<div class="result-total-row"><span>Estimated landed cost</span><span class="val">${fmtEstimate(r.total)}</span></div>` +
      '<p class="rate-meta">Estimated figures — not an exact quote. Verify current duty/VAT and FX before transacting.</p>';
  }

  for (const id of ids) el(id).addEventListener("input", compute);
  el("country").addEventListener("change", compute);
  el("model").addEventListener("change", compute);
  compute();
</script>
