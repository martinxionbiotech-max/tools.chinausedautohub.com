---
import BaseLayout from "../../../shared/components/BaseLayout.astro";
import { TOOLS_SITE_URL, MARKET_SITE_URL, DATA_SITE_URL, MAIN_SITE_URL } from "../../../shared/config/config";
import countriesData from "../../../shared/data/countries.json";
import taxrulesData from "../../../shared/data/taxrules.json";
import "../../styles/tools.css";

const siteTitle = "China Used Car Export Tools";
const pageUrl = TOOLS_SITE_URL + "/ev-import-cost-calculator/";

const countries = countriesData.countries;
const taxrules = taxrulesData.taxrules;
const lastChecked = [...new Set(taxrules.map((r) => r.last_checked).filter(Boolean))].join(", ");

// Pre-build: country_id -> { import_duty rules[], vat rule }.
// A country may hold a standard duty AND a reduced/exempt EV duty entry.
const taxByCountry = {};
for (const r of taxrules) {
  const bucket = (taxByCountry[r.country_id] = taxByCountry[r.country_id] || {});
  if (r.tax_type === "import_duty") (bucket.duties = bucket.duties || []).push(r);
  else if (r.tax_type === "vat") bucket.vat = r;
}

// Helpers to pick the standard (higher) duty vs an EV-specific (lower) one.
const isEvRule = (r) => /electric|ev/i.test(r.label || "") || /ev/i.test(r.taxrule_id || "");
const standardDuty = (duties) => duties?.filter((d) => !isEvRule(d)).sort((a, b) => b.rate_pct - a.rate_pct)[0];
const evDuty = (duties) => duties?.filter(isEvRule).sort((a, b) => a.rate_pct - b.rate_pct)[0];

const webApp = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "EV Import Cost Calculator",
  url: pageUrl,
  applicationCategory: "FinanceApplication",
  operatingSystem: "Web",
  description: "Estimate the landed cost of an electric vehicle — vehicle price, shipping, insurance, import duty (standard and any EV-specific incentive) and VAT — for seven destination markets.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Tools", item: TOOLS_SITE_URL + "/" },
    { "@type": "ListItem", position: 2, name: "EV Import Cost Calculator", item: pageUrl },
  ],
};

const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Do electric vehicles pay lower import duty?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Some countries apply reduced or zero import duty on electric vehicles, but this varies by country and changes frequently. This tool shows any EV-specific rate present in our data alongside the standard duty, and tells you to verify current incentives with official customs.",
      },
    },
    {
      "@type": "Question",
      name: "Are EV duty incentives guaranteed?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. EV duty incentives are policy measures that change frequently and may be temporary, budget-dependent, or subject to eligibility conditions. Always confirm the current rate with the destination customs authority before trading.",
      },
    },
  ],
};
---

<BaseLayout
  siteTitle={siteTitle}
  siteUrl={TOOLS_SITE_URL}
  currentSection="tools"
  title="EV Import Cost Calculator — China Used Car Export"
  description="Estimate the landed cost of an electric vehicle — price, shipping, insurance, import duty (standard and EV incentive) and VAT — for seven destination markets, with sources and dates."
  canonical="/ev-import-cost-calculator/"
  jsonLd={[webApp, breadcrumb, faq]}
  lastUpdated={lastChecked}
  breadcrumbs={[
    { name: "Tools", url: TOOLS_SITE_URL + "/" },
    { name: "EV Import Cost Calculator", url: pageUrl },
  ]}
>
  <h1>EV Import Cost Calculator</h1>
  <p class="lede">
    Estimate the landed cost of an electric vehicle, comparing the standard
    import duty against any EV-specific incentive rate where one exists in the data.
  </p>

  <div class="note warn">
    EV duty incentives vary by country and change frequently — verify current
    rates with official customs before trading.
  </div>

  <div class="section">
    <h2>Inputs</h2>
    <div class="form-grid">
      <div class="field">
        <label for="vehicle">Vehicle price (USD)</label>
        <input id="vehicle" type="number" inputmode="decimal" min="0" step="any" placeholder="e.g. 22000" />
      </div>
      <div class="field">
        <label for="country">Destination country</label>
        <select id="country">
          {countries.map((c) => <option value={c.country_id}>{c.name}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="shipping">Shipping cost (USD)</label>
        <input id="shipping" type="number" inputmode="decimal" min="0" step="any" placeholder="e.g. 2500" />
        <span class="hint">You provide this — we do not publish unverified freight rates.</span>
      </div>
      <div class="field">
        <label for="insurance">Insurance (USD)</label>
        <input id="insurance" type="number" inputmode="decimal" min="0" step="any" placeholder="e.g. 200" />
      </div>
    </div>
    <p class="form-error" id="error"></p>
  </div>

  <div class="section">
    <h2>Applied rates</h2>
    <div id="rate-box" class="rate-card">
      <p class="rate-meta">Select a destination country to load duty and VAT rates.</p>
    </div>
  </div>

  <div class="section">
    <h2>Estimated result</h2>
    <div class="result-panel" id="result">
      <p class="rate-meta">Enter a vehicle price to see the landed-cost breakdown.</p>
    </div>
  </div>

  <div class="section">
    <h2>Calculation logic</h2>
    <div class="formula">CIF value   = Vehicle price + Shipping + Insurance
Import duty = CIF value × Import duty %   (standard or EV incentive rate)
VAT         = (CIF value + Import duty) × VAT %
Landed cost = Vehicle + Shipping + Insurance + Duty + VAT</div>
    <p>Duty basis "CIF value" and VAT basis "CIF + duty" follow the stored tax-rule <code>basis</code> fields.</p>
  </div>

  <div class="section">
    <h2>Assumptions</h2>
    <ul>
      <li>Shipping and insurance are the figures you enter — none are assumed.</li>
      <li>Where the data holds both a standard duty and an EV-specific rate, both scenarios are shown.</li>
      <li>Excludes destination-port handling, inland transport and any EV-specific registration incentives.</li>
    </ul>
  </div>

  <div class="section">
    <h2>Limitations</h2>
    <ul>
      <li>EV duty incentives are policy measures that change frequently and are flagged "needs review".</li>
      <li>Customs valuation may differ from the declared price.</li>
      <li>Exchange rates are a snapshot and fluctuate daily.</li>
    </ul>
  </div>

  <div class="section">
    <h2>Related vehicles</h2>
    <div class="related-grid">
      <a href={DATA_SITE_URL + "/models/byd-atto-3/"}>BYD Atto 3</a>
      <a href={DATA_SITE_URL + "/models/byd-song-plus/"}>BYD Song Plus</a>
      <a href={DATA_SITE_URL + "/vehicle-types/ev/"}>All EVs</a>
    </div>
  </div>

  <div class="section">
    <h2>Related countries</h2>
    <div class="related-grid">
      {countries.map((c) => (
        <a href={MARKET_SITE_URL + "/countries/" + c.country_id + "/"}>{c.name}</a>
      ))}
    </div>
  </div>

  <div class="cta-band">
    <h2>Request a vehicle</h2>
    <p>Ready to buy an EV? Get a real quote on available vehicles.</p>
    <a class="btn" href={MAIN_SITE_URL + "/contact/"}>Request a Vehicle</a>
  </div>
</BaseLayout>

<script type="application/json" id="tax-by-country" set:html={JSON.stringify(taxByCountry)}></script>
<script type="application/json" id="site-config" set:html={JSON.stringify({ marketUrl: MARKET_SITE_URL })}></script>
<script>
  import { calcLandedCost, fmtMoney } from "../../lib/calc.js";

  const taxByCountry = JSON.parse(document.getElementById("tax-by-country").textContent);
  const marketUrl = JSON.parse(document.getElementById("site-config").textContent).marketUrl;

  const el = (id) => document.getElementById(id);
  const ids = ["vehicle", "shipping", "insurance"];

  const isEvRule = (r) => /electric|ev/i.test(r.label || "") || /ev/i.test(r.taxrule_id || "");

  function num(id) {
    const v = el(id).value.trim();
    if (v === "") return 0;
    const n = Number(v);
    return Number.isFinite(n) && n >= 0 ? n : NaN;
  }

  function renderRates(countryId) {
    const box = el("rate-box");
    const c = taxByCountry[countryId];
    const duties = c && c.duties ? c.duties : [];
    const vat = c && c.vat;
    const std = duties.filter((d) => !isEvRule(d)).sort((a, b) => b.rate_pct - a.rate_pct)[0];
    const ev = duties.filter(isEvRule).sort((a, b) => a.rate_pct - b.rate_pct)[0];
    const row = (label, rule) => {
      if (!rule) return "";
      const flag = rule.needs_review ? ' <span class="badge badge-review">needs review</span>' : "";
      return `<div class="rate-row">
        <span>${label}</span>
        <span class="rate-pct">${rule.rate_pct}%</span>
        <span class="rate-meta">${rule.label} · ${rule.basis}${flag}<br/>Source: ${rule.source} · ${rule.last_checked}</span>
      </div>`;
    };
    box.innerHTML =
      row("Standard import duty", std) +
      (ev && ev.taxrule_id !== (std && std.taxrule_id) ? row("EV import duty (incentive)", ev) : "") +
      row("VAT", vat) +
      (ev ? '<p class="rate-meta" style="margin-top:8px">Two duty scenarios shown — standard vs EV-specific. Verify current incentives.</p>' : "") +
      `<p class="rate-meta" style="margin-top:8px"><a href="${marketUrl}/countries/${countryId}/" target="_blank" rel="noopener">Check current regulations →</a></p>`;
  }

  function compute() {
    const countryId = el("country").value;
    renderRates(countryId);

    const vals = {};
    let ok = true;
    for (const id of ids) {
      vals[id] = num(id);
      if (Number.isNaN(vals[id])) { ok = false; el(id).classList.add("invalid"); }
      else el(id).classList.remove("invalid");
    }
    const err = el("error");
    if (!ok) {
      err.textContent = "All inputs must be non-negative numbers.";
      el("result").innerHTML = '<p class="rate-meta">Fix the highlighted fields to see the breakdown.</p>';
      return;
    }
    err.textContent = "";

    const c = taxByCountry[countryId] || {};
    const duties = c.duties || [];
    const std = duties.filter((d) => !isEvRule(d)).sort((a, b) => b.rate_pct - a.rate_pct)[0];
    const ev = duties.filter(isEvRule).sort((a, b) => a.rate_pct - b.rate_pct)[0];
    const vat = c.vat;

    const line = (label, v) =>
      `<div class="result-line"><span>${label}</span><span class="val">${fmtMoney(v)}</span></div>`;

    let html = line("Vehicle cost", Number(vals.vehicle)) +
      line("Shipping", Number(vals.shipping)) +
      line("Insurance", Number(vals.insurance));

    if (std) {
      const stdR = calcLandedCost({
        vehiclePrice: vals.vehicle, shipping: vals.shipping, insurance: vals.insurance,
        dutyRatePct: std.rate_pct, vatRatePct: (vat && vat.rate_pct) || 0,
      });
      html +=
        `<div class="result-total-row"><span>Landed cost — standard duty ${std.rate_pct}%</span><span class="val">${fmtMoney(stdR.total)}</span></div>`;
    }
    if (ev && ev.taxrule_id !== (std && std.taxrule_id)) {
      const evR = calcLandedCost({
        vehiclePrice: vals.vehicle, shipping: vals.shipping, insurance: vals.insurance,
        dutyRatePct: ev.rate_pct, vatRatePct: (vat && vat.rate_pct) || 0,
      });
      html +=
        `<div class="result-total-row"><span>Landed cost — EV incentive duty ${ev.rate_pct}%</span><span class="val">${fmtMoney(evR.total)}</span></div>`;
    }

    el("result").innerHTML = html +
      '<p class="rate-meta">All figures are estimates. Verify current EV duty/VAT and FX before transacting.</p>';
  }

  for (const id of ids) el(id).addEventListener("input", compute);
  el("country").addEventListener("change", compute);
  compute();
</script>
