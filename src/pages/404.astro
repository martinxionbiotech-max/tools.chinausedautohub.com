---
import BaseLayout from "../../shared/components/BaseLayout.astro";
import { TOOLS_SITE_URL } from "../../shared/config/config";
import "../styles/tools.css";

const siteTitle = "China Used Car Export Tools";
---

<BaseLayout
  siteTitle={siteTitle}
  siteUrl={TOOLS_SITE_URL}
  currentSection="tools"
  title="Page Not Found — China Used Car Export Tools"
  description="This page could not be found. Return to the China Used Car Export tools directory."
>
  <h1>Page not found</h1>
  <p class="lede">
    The page you're looking for doesn't exist or has moved.
  </p>

  <div class="section">
    <p>Try one of these instead:</p>
    <div class="related-grid">
      <a href={TOOLS_SITE_URL + "/"}>Tools directory</a>
      <a href={TOOLS_SITE_URL + "/landed-cost-calculator/"}>Landed Cost Calculator</a>
      <a href={TOOLS_SITE_URL + "/currency-converter/"}>Currency Converter</a>
    </div>
  </div>
</BaseLayout>
